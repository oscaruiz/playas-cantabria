# Production API base URL
REACT_APP_API_BASE_URL=https://playas-cantabria.onrender.com

# Public origin of the deployed site: canonical URLs, og:url, sitemap,
# manifest and the share card host all derive from it. This value belongs to
# the region being DEPLOYED from this checkout (cantabria). When building
# another region, override it (or set it empty) so that region does not
# inherit this domain.
REACT_APP_SITE_ORIGIN=https://playucas.es
