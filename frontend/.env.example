# Copy to .env.development or .env.production and adjust as needed.
REACT_APP_API_BASE_URL=https://playas-cantabria.onrender.com

# Region this build serves. Must match a directory in root regions/.
# Leave it out for Cantabria, which is the default.
# REACT_APP_REGION=asturias

# Public origin of the deployed site (custom domain). Drives canonical/og:url,
# sitemap, robots, the manifest and the share card host — both in the CRA
# bundle and in the Node build scripts (site-origin.mjs reads .env.production).
# It belongs to the site being deployed: override or empty it when building a
# different region, or that region inherits this domain.
# REACT_APP_SITE_ORIGIN=https://playucas.es
